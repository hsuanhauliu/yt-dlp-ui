{
  "sourceLanguage": "en",
  "strings": {
    "%@ didn’t run correctly:\n%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ didn’t run correctly:\n%2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 無法正常執行：\n%2$@"
          }
        }
      }
    },
    "%@. yt-dlp is checked automatically about once a day. ffmpeg is bundled and moves only with an app update.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。yt-dlp 每天會自動檢查一次更新。ffmpeg 隨應用程式附帶，僅在應用程式更新時一併更新。"
          }
        }
      }
    },
    "A download is still in progress.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "仍有下載正在進行。"
          }
        }
      }
    },
    "Audio": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊"
          }
        }
